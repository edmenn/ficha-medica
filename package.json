{
  "name": "ficha-medica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "reset:operational-data": "node scripts/reset-operational-data.mjs",
    "db:verify-prod": "DB_PASS=${DB_PASS:-$(grep '^DB_PASS=' .env.local.prod-backup | cut -d= -f2-)} bash scripts/verify-prod-schema.sh",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:seed": "set -a && source .env.local && set +a && node scripts/seed-local.mjs",
    "db:clone-prod": "set -a && source .env.local.prod-backup && set +a && DB_PASS=\"$DB_PASS\" SUPABASE_SERVICE_ROLE_KEY_PROD=\"$SUPABASE_SERVICE_ROLE_KEY\" SUPABASE_SERVICE_ROLE_KEY_LOCAL=$(set -a && source .env.local && set +a && echo \"$SUPABASE_SERVICE_ROLE_KEY\") bash scripts/clone-prod-to-local.sh"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "exceljs": "^4.4.0",
    "heic2any": "^0.0.4",
    "next": "^15.5.21",
    "openai": "^6.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "8.57.0",
    "eslint-config-next": "^15.5.21",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
